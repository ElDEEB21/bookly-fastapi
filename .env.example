# Copy this file to .env and fill in real values:
#   cp .env.example .env        # macOS / Linux
#   Copy-Item .env.example .env # Windows (PowerShell)
# Never commit .env (it is git-ignored).

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookly

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Redis (cache, token blocklist, rate limits, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Email (FastAPI-Mail, sent via Celery worker) ---
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Bookly
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# --- App URLs (used to build verification / password-reset links) ---
DOMAIN=localhost:8000
SCHEME=http

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Optional ---
FIRST_ADMIN_EMAIL=
